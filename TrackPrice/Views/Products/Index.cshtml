@model IEnumerable<TrackPrice.Models.ReefApiProduct>

@{
    ViewData["Title"] = "Search Results";

    var selectedSort =
        ViewBag.Sort as string ?? "";

    var search =
        ViewBag.Search as string ?? "";
}

<div class="container py-5">

    <!-- Header -->
    <div class="mb-4">

        <h1 class="fw-bold">
            Search Results
        </h1>

        @if (!string.IsNullOrWhiteSpace(search))
        {
            <p class="text-muted mb-0">
                Results for
                "<strong>@search</strong>"
            </p>
        }

    </div>


    <!-- Sorting -->
    @if (Model.Any())
    {
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <form asp-action="Index"
                      method="get">

                    <!-- Keep current search -->
                    <input type="hidden"
                           name="search"
                           value="@search" />

                    <div class="row g-3 align-items-end">

                        <!-- Sort -->
                        <div class="col-md-8">

                            <label for="sort"
                                   class="form-label fw-semibold">
                                Sort By
                            </label>

                            <select id="sort"
                                    name="sort"
                                    class="form-select">

                                <option value="">
                                    Default
                                </option>

                                @if (selectedSort == "price_asc")
                                {
                                    <option value="price_asc"
                                            selected>
                                        Price: Low to High
                                    </option>
                                }
                                else
                                {
                                    <option value="price_asc">
                                        Price: Low to High
                                    </option>
                                }

                                @if (selectedSort == "price_desc")
                                {
                                    <option value="price_desc"
                                            selected>
                                        Price: High to Low
                                    </option>
                                }
                                else
                                {
                                    <option value="price_desc">
                                        Price: High to Low
                                    </option>
                                }

                                @if (selectedSort == "name_asc")
                                {
                                    <option value="name_asc"
                                            selected>
                                        Name: A to Z
                                    </option>
                                }
                                else
                                {
                                    <option value="name_asc">
                                        Name: A to Z
                                    </option>
                                }

                                @if (selectedSort == "name_desc")
                                {
                                    <option value="name_desc"
                                            selected>
                                        Name: Z to A
                                    </option>
                                }
                                else
                                {
                                    <option value="name_desc">
                                        Name: Z to A
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- Apply -->
                        <div class="col-md-2">

                            <button type="submit"
                                    class="btn btn-primary w-100">

                                Apply

                            </button>

                        </div>


                        <!-- Clear -->
                        <div class="col-md-2">

                            @if (!string.IsNullOrWhiteSpace(selectedSort))
                            {
                                <a asp-action="Index"
                                   asp-route-search="@search"
                                   class="btn btn-outline-secondary w-100">

                                    Clear

                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-outline-secondary w-100"
                                        disabled>

                                    Clear

                                </button>
                            }

                        </div>

                    </div>

                </form>

            </div>

        </div>
    }


    <!-- No Results -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">

            <strong>No products found.</strong>

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <div class="mt-1">
                    Try another search term.
                </div>
            }

        </div>
    }
    else
    {
        <!-- Result Count -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <span class="text-muted">
                Showing
                <strong>@Model.Count()</strong>
                product@(Model.Count() == 1 ? "" : "s")
            </span>

        </div>


        <!-- Product Cards -->
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <!-- Product Image -->
                        @if (!string.IsNullOrWhiteSpace(product.Image))
                        {
                            <img src="@product.Image"
                                 class="card-img-top"
                                 style="height:220px; object-fit:contain; padding:15px;"
                                 alt="@product.Title" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:220px;">

                                <span class="text-muted">
                                    No Image Available
                                </span>

                            </div>
                        }


                        <div class="card-body d-flex flex-column">

                            <!-- Product Name -->
                            <h5 class="card-title fw-bold">
                                @product.Title
                            </h5>


                            <!-- Price -->
                            <div class="mb-2">

                                <span class="fs-4 fw-bold">
                                    ₹@product.Price.ToString("N2")
                                </span>

                            </div>


                            <!-- MRP + Discount -->
                            @if (product.Mrp.HasValue &&
                                 product.Mrp.Value > product.Price)
                            {
                                <div>

                                    <span class="text-muted text-decoration-line-through">
                                        ₹@product.Mrp.Value.ToString("N2")
                                    </span>

                                    @if (product.DiscountPercent > 0)
                                    {
                                        <span class="badge bg-success ms-2">
                                            @product.DiscountPercent.ToString("0")% OFF
                                        </span>
                                    }

                                </div>
                            }


                            <!-- Rating -->
                            @if (product.Rating > 0)
                            {
                                <div class="mt-2">

                                    <span class="badge bg-warning text-dark">
                                        ★ @product.Rating.ToString("0.0")
                                    </span>

                                    @if (product.RatingCount > 0)
                                    {
                                        <small class="text-muted ms-1">
                                            (@product.RatingCount.ToString("N0") ratings)
                                        </small>
                                    }

                                </div>
                            }


                            <!-- Availability -->
                            <div class="mt-2">

                                @if (product.InStock)
                                {
                                    <span class="badge bg-success">
                                        In Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Out of Stock
                                    </span>
                                }

                            </div>


                            <!-- View Details Button -->
                            <div class="mt-auto pt-4">

                                <a asp-action="Details"
                                   asp-route-url="@product.Url"
                                   asp-route-itmId="@product.ItemId"
                                   class="btn btn-primary w-100">

                                    View Details

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>