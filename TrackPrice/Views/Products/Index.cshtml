@model IEnumerable<TrackPrice.Models.ReefApiProduct>

@{
    ViewData["Title"] = "Search Results";
}

<div class="container py-5">

    <!-- Header -->
    <div class="mb-4">

        <h1 class="fw-bold">
            Search Results
        </h1>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
        {
            <p class="text-muted mb-0">
                Results for
                "<strong>@ViewBag.Search</strong>"
            </p>
        }

    </div>


    <!-- No Results -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No products found.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <!-- Product Image -->
                        @if (!string.IsNullOrWhiteSpace(product.Image))
                        {
                            <img src="@product.Image"
                                 class="card-img-top"
                                 style="height:220px; object-fit:contain; padding:15px;"
                                 alt="@product.Title" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:220px;">

                                <span class="text-muted">
                                    No Image Available
                                </span>

                            </div>
                        }


                        <div class="card-body d-flex flex-column">

                            <!-- Product Name -->
                            <h5 class="card-title fw-bold">
                                @product.Title
                            </h5>


                            <!-- Category -->
                            @if (!string.IsNullOrWhiteSpace(product.Category))
                            {
                                <span class="badge bg-secondary align-self-start mb-3">
                                    @product.Category
                                </span>
                            }


                            <!-- Price -->
                            <div class="mb-2">

                                <span class="fs-4 fw-bold">
                                    ₹@product.Price.ToString("N2")
                                </span>

                            </div>


                            <!-- MRP + Discount -->
                            @if (product.Mrp.HasValue &&
                                 product.Mrp.Value > product.Price)
                            {
                                <div>

                                    <span class="text-muted text-decoration-line-through">
                                        ₹@product.Mrp.Value.ToString("N2")
                                    </span>

                                    @if (product.DiscountPercent > 0)
                                    {
                                        <span class="badge bg-success ms-2">
                                            @product.DiscountPercent.ToString("0")% OFF
                                        </span>
                                    }

                                </div>
                            }


                            <!-- Rating -->
                            @if (product.Rating > 0)
                            {
                                <div class="mt-2">

                                    <span class="badge bg-warning text-dark">
                                        ★ @product.Rating.ToString("0.0")
                                    </span>

                                    @if (product.RatingCount > 0)
                                    {
                                        <small class="text-muted ms-1">
                                            (@product.RatingCount.ToString("N0") ratings)
                                        </small>
                                    }

                                </div>
                            }


                            <!-- Availability -->
                            <div class="mt-2">

                                @if (product.InStock)
                                {
                                    <span class="badge bg-success">
                                        In Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Out of Stock
                                    </span>
                                }

                            </div>


                            <!-- View Details Button -->
                            <div class="mt-auto pt-4">

                                <a asp-action="Details"
                                   asp-route-url="@product.Url"
                                   asp-route-itmId="@product.ItemId"
                                   class="btn btn-primary w-100">

                                    View Details

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>