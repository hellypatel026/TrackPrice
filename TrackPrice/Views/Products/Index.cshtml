@model IEnumerable<TrackPrice.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Products</h1>
            <p class="text-muted mb-0">
                Browse products tracked by TrackPrice
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No products are available yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 class="card-img-top"
                                 style="height:220px; object-fit:contain;"
                                 alt="@product.Name" />
                        }

                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                @product.Name
                            </h5>

                            @if (!string.IsNullOrEmpty(product.Category))
                            {
                                <span class="badge bg-secondary mb-2">
                                    @product.Category
                                </span>
                            }

                            @if (!string.IsNullOrEmpty(product.Description))
                            {
                                <p class="card-text text-muted">
                                    @product.Description
                                </p>
                            }

                            @if (product.ProductListings.Any())
                            {
                                <hr />

                                <h6 class="fw-bold">Available Prices</h6>

                                @foreach (var listing in product.ProductListings)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">

                                        <span>
                                            @listing.Store.Name
                                        </span>

                                        <strong>
                                            ₹@listing.CurrentPrice.ToString("N2")
                                        </strong>

                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mt-3 mb-0">
                                    No price information available.
                                </p>
                            }

                            <a asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-primary w-100 mt-3">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>