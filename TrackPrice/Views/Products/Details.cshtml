@model TrackPrice.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            ← Back to Products
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="row">

                <!-- Product Image -->
                <div class="col-md-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             class="img-fluid"
                             style="max-height:350px; object-fit:contain;"
                             alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="bg-light rounded p-5 text-muted">
                            No Image Available
                        </div>
                    }

                </div>

                <!-- Product Information -->
                <div class="col-md-8">

                    <h1 class="fw-bold">@Model.Name</h1>

                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <span class="badge bg-secondary mb-3">
                            @Model.Category
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="text-muted">
                            @Model.Description
                        </p>
                    }

                    <hr />

                    <h4 class="fw-bold mb-3">Store Prices</h4>

                    @if (Model.ProductListings.Any())
                    {
                        @foreach (var listing in Model.ProductListings)
                        {
                            <div class="border rounded p-3 mb-3">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>
                                        <h5 class="mb-1">
                                            @listing.Store.Name
                                        </h5>

                                        @if (listing.IsAvailable)
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Out of Stock
                                            </span>
                                        }
                                    </div>

                                    <div class="text-end">

                                        <h4 class="fw-bold mb-2">
                                            ₹@listing.CurrentPrice.ToString("N2")
                                        </h4>

                                        <a href="@listing.ProductUrl"
                                           target="_blank"
                                           class="btn btn-primary btn-sm">
                                            Visit Store
                                        </a>

                                    </div>

                                </div>

                                <small class="text-muted">
                                    Last updated:
                                    @listing.LastUpdated.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </small>

                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">
                            No store price information available.
                        </p>
                    }

                </div>

            </div>

        </div>
    </div>

</div>