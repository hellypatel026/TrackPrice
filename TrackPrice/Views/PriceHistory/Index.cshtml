@using TrackPrice.Models
@model List<PriceHistory>

@{
    var product = ViewBag.Product as Product;
}

@{
    ViewData["Title"] = "Price History";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Price History</h2>

            @if (product != null)
            {
                <p class="text-muted mb-0">
                    @product.Name
                </p>
            }
        </div>

        <a asp-controller="PriceHistory"
           asp-action="Index"
           asp-route-productId="@(product?.Id)"
           class="btn btn-secondary">
            Refresh
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No price history is available yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Date & Time</th>
                                <th>Store</th>
                                <th>Price</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var history in Model)
                            {
                                <tr>
                                    <td>
                                        @history.RecordedAt.ToLocalTime()
                                        .ToString("dd MMM yyyy, hh:mm tt")
                                    </td>

                                    <td>
                                        @(history.ProductListing?.Store?.Name
                                            ?? "Unknown")
                                    </td>

                                    <td>
                                        <strong>
                                            ₹@history.Price.ToString("N2")
                                        </strong>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-controller="PriceAlert"
           asp-action="Index"
           class="btn btn-outline-primary">
            Back to Price Alerts
        </a>
    </div>

</div>