@model TrackPrice.Controllers.PriceHistoryViewModel

@{
    ViewData["Title"] = "Price History";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">📈 Price History</h1>
            <p class="text-muted mb-0">
                Track how the product price changed over time.
            </p>
        </div>

        <a asp-controller="Watchlist"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Watchlist
        </a>
    </div>

    @if (Model.ProductId == 0)
    {
        <div class="alert alert-info">
            <strong>No product selected.</strong>
            Please select a product from your watchlist.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">

                <div class="row align-items-center">

                    <div class="col-md-8">
                        <h2 class="fw-bold mb-2">
                            @Model.ProductName
                        </h2>

                        <p class="text-muted mb-0">
                            Store:
                            <strong>@Model.StoreName</strong>
                        </p>
                    </div>

                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        <small class="text-muted d-block">
                            Current Price
                        </small>

                        <span class="fs-2 fw-bold text-success">
                            ₹@Model.CurrentPrice.ToString("N2")
                        </span>
                    </div>

                </div>

            </div>
        </div>

        @if (Model.History == null || !Model.History.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-5 text-center">

                    <div style="font-size:48px;">📊</div>

                    <h4 class="fw-bold mt-3">
                        No price history is available yet.
                    </h4>

                    <p class="text-muted mb-0">
                        Price history will appear after the product
                        has been tracked.
                    </p>

                </div>
            </div>
        }
        else
        {
            var lowestPrice = Model.History.Min(x => x.Price);
            var highestPrice = Model.History.Max(x => x.Price);
            var firstPrice = Model.History.First().Price;
            var latestPrice = Model.History.Last().Price;

            var priceChange = latestPrice - firstPrice;

            var priceChangePercent =
                firstPrice == 0
                    ? 0
                    : (priceChange / firstPrice) * 100;

            <div class="row g-3 mb-4">

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <small class="text-muted">
                                Lowest Price
                            </small>

                            <h3 class="fw-bold text-success mt-2">
                                ₹@lowestPrice.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <small class="text-muted">
                                Highest Price
                            </small>

                            <h3 class="fw-bold text-danger mt-2">
                                ₹@highestPrice.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <small class="text-muted">
                                First Recorded Price
                            </small>

                            <h3 class="fw-bold mt-2">
                                ₹@firstPrice.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <small class="text-muted">
                                Price Change
                            </small>

                            @if (priceChange < 0)
                            {
                                <h3 class="fw-bold text-success mt-2">
                                    ↓ ₹@Math.Abs(priceChange).ToString("N2")
                                </h3>
                            }
                            else if (priceChange > 0)
                            {
                                <h3 class="fw-bold text-danger mt-2">
                                    ↑ ₹@priceChange.ToString("N2")
                                </h3>
                            }
                            else
                            {
                                <h3 class="fw-bold text-secondary mt-2">
                                    → ₹0.00
                                </h3>
                            }

                            <small class="text-muted">
                                @priceChangePercent.ToString("0.00")%
                            </small>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>
                            <h3 class="fw-bold mb-1">
                                Price Trend
                            </h3>

                            <p class="text-muted mb-0">
                                Daily effective price
                            </p>
                        </div>

                        <span class="badge bg-light text-dark">
                            @Model.History.Count day(s)
                        </span>

                    </div>

                    <div style="position:relative; width:100%; height:420px;">
                        <canvas id="priceHistoryChart"></canvas>
                    </div>

                </div>

            </div>

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-3">
                        Daily Price History
                    </h3>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Price</th>
                                    <th>Change</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    decimal? previousPrice = null;
                                }

                                @foreach (var history in Model.History)
                                {
                                    var dailyChange = previousPrice.HasValue
                                        ? history.Price - previousPrice.Value
                                        : 0;

                                    <tr>

                                        <td>
                                            @history.Date.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            <strong>
                                                ₹@history.Price.ToString("N2")
                                            </strong>
                                        </td>

                                        <td>

                                            @if (!previousPrice.HasValue)
                                            {
                                                <span class="text-muted">
                                                    —
                                                </span>
                                            }
                                            else if (dailyChange < 0)
                                            {
                                                <span class="text-success fw-bold">
                                                    ↓ ₹@Math.Abs(dailyChange).ToString("N2")
                                                </span>
                                            }
                                            else if (dailyChange > 0)
                                            {
                                                <span class="text-danger fw-bold">
                                                    ↑ ₹@dailyChange.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    No change
                                                </span>
                                            }

                                        </td>

                                    </tr>

                                    previousPrice = history.Price;
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }
    }

</div>

@if (Model.History != null && Model.History.Any())
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const priceHistoryLabels = [
                    @foreach (var item in Model.History)
            {
                @: "@item.Date.ToString("dd MMM")",
            }
                ];

        const priceHistoryData = [
                    @foreach (var item in Model.History)
            {
                @: @item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture),
            }
                ];

        const chartCanvas =
            document.getElementById("priceHistoryChart");

        if (chartCanvas) {

            new Chart(chartCanvas, {

                type: "line",

                data: {

                    labels: priceHistoryLabels,

                    datasets: [{

                        label: "Price (₹)",

                        data: priceHistoryData,

                        borderWidth: 3,

                        pointRadius: 5,

                        pointHoverRadius: 7,

                        tension: 0.25,

                        fill: true

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    interaction: {
                        mode: "index",
                        intersect: false
                    },

                    plugins: {

                        legend: {
                            display: true
                        },

                        tooltip: {

                            callbacks: {

                                label: function(context) {

                                    return "Price: ₹" +
                                        Number(context.raw)
                                            .toLocaleString(
                                                "en-IN",
                                                {
                                                    minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2
                                                }
                                            );
                                }

                            }

                        }

                    },

                    scales: {

                        x: {

                            title: {
                                display: true,
                                text: "Date"
                            }

                        },

                        y: {

                            beginAtZero: false,

                            title: {
                                display: true,
                                text: "Price (₹)"
                            },

                            ticks: {

                                callback: function(value) {

                                    return "₹" +
                                        Number(value)
                                            .toLocaleString("en-IN");

                                }

                            }

                        }

                    }

                }

            });

        }

    </script>
}