@using TrackPrice.Models
@model List<PriceHistory>

@{
    var product = ViewBag.Product as Product;
}

@{
    ViewData["Title"] = "Price History";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Price History</h2>

            @if (product != null)
            {
                <p class="text-muted mb-0">
                    @product.Name
                </p>
            }
        </div>

        <a asp-controller="PriceHistory"
           asp-action="Index"
           asp-route-productId="@(product?.Id)"
           class="btn btn-secondary">
            Refresh
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No price history is available yet.
        </div>
    }
    else
    {
        <!-- Price Chart -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="card-title mb-3">
                    Price Trend
                </h5>

                <div style="height: 350px;">
                    <canvas id="priceHistoryChart"></canvas>
                </div>

            </div>
        </div>

        <!-- Price History Table -->
        <div class="card shadow-sm">
            <div class="card-body">

                <h5 class="card-title mb-3">
                    Price History Records
                </h5>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Date & Time</th>
                                <th>Store</th>
                                <th>Price</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var history in Model)
                            {
                                <tr>
                                    <td>
                                        @(history.RecordedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))
                                    </td>

                                    <td>
                                        @(history.ProductListing?.Store?.Name
                                            ?? "Unknown")
                                    </td>

                                    <td>
                                        <strong>
                                            ₹@history.Price.ToString("N2")
                                        </strong>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

    <div class="mt-3 mb-4">
        <a asp-controller="PriceAlert"
           asp-action="Index"
           class="btn btn-outline-primary">
            Back to Price Alerts
        </a>
    </div>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const priceHistoryData = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model
                                    .OrderBy(h => h.RecordedAt)
                                    .Select(h => new
                                    {
                                            date = h.RecordedAt
                                                    .ToLocalTime()
                                                    .ToString("dd MMM HH:mm"),
                                            price = h.Price
                                    })
                    )
            );

        const labels = priceHistoryData.map(item => item.date);
        const prices = priceHistoryData.map(item => item.price);

        const ctx = document
            .getElementById('priceHistoryChart')
            .getContext('2d');

        new Chart(ctx, {
            type: 'line',

            data: {
                labels: labels,

                datasets: [
                    {
                        label: 'Price (₹)',
                        data: prices,

                        borderWidth: 2,
                        tension: 0.3,

                        fill: false,

                        pointRadius: 4,
                        pointHoverRadius: 6
                    }
                ]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                scales: {
                    y: {
                        beginAtZero: false,

                        ticks: {
                            callback: function(value) {
                                return '₹' + value;
                            }
                        }
                    }
                },

                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return '₹' +
                                    Number(context.raw)
                                        .toLocaleString('en-IN', {
                                            minimumFractionDigits: 2,
                                            maximumFractionDigits: 2
                                        });
                            }
                        }
                    }
                }
            }
        });
    </script>
}