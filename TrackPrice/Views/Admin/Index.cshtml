@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Admin Dashboard</h1>
        <p class="text-muted">
            Manage and monitor TrackPrice.
        </p>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Registered Users</h6>
                    <h2 class="fw-bold">0</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Products Tracked</h6>
                    <h2 class="fw-bold">0</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Amazon Listings</h6>
                    <h2 class="fw-bold">0</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Flipkart Listings</h6>
                    <h2 class="fw-bold">0</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Management -->
    <div class="row g-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">👥 Users</h4>
                    <p class="text-muted">
                        View registered TrackPrice users.
                    </p>

                    <a href="#" class="btn btn-dark">
                        Manage Users
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">🔌 API Data</h4>
                    <p class="text-muted">
                        Monitor product and price data received
                        from Amazon and Flipkart.
                    </p>

                    <a href="#" class="btn btn-dark">
                        View API Data
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">🔔 Price Alerts</h4>
                    <p class="text-muted">
                        View active price alerts created by users.
                    </p>

                    <a href="#" class="btn btn-dark">
                        View Alerts
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">📈 Price History</h4>
                    <p class="text-muted">
                        Monitor stored historical price information.
                    </p>

                    <a href="#" class="btn btn-dark">
                        View Price History
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>