@{
    ViewData["Title"] = "TrackPrice";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold">TrackPrice</h1>

    <p class="lead">
        Track prices. Compare stores. Save money.
    </p>

    <div class="mt-4">
        <input type="text"
               class="form-control d-inline-block"
               placeholder="Search for a product..."
               style="max-width: 500px;" />

        <button class="btn btn-primary mt-3">
            Search
        </button>
    </div>
</div>